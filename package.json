{
  "name": "tozasareta-machi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "playwright": "./scripts/playwright.sh",
    "art:validate": "node ./scripts/validate-town-art.mjs",
    "test": "npm run art:validate && vitest run",
    "test:e2e": "node ./scripts/e2e.mjs && node ./scripts/e2e-planning-placement.mjs && node ./scripts/e2e-planning-polish.mjs && node ./scripts/e2e-prologue.mjs",
    "test:prod": "node ./scripts/production-smoke.mjs",
    "test:visual": "node ./scripts/visual-regression.mjs && node ./scripts/visual-prologue.mjs",
    "test:visual:update": "UPDATE_VISUAL_BASELINES=1 node ./scripts/visual-regression.mjs && UPDATE_VISUAL_BASELINES=1 node ./scripts/visual-prologue.mjs",
    "test:watch": "vitest",
    "sim": "vitest run --testNamePattern simulation"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/pngjs": "^6.0.5",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
